# ChatBot-WA / BuilderBot — Environment variable template
# Copy this file to .env and replace placeholder values before starting services.
# .env is gitignored (see .gitignore). Never commit real secrets.

# ---------------------------------------------------------------
# Global
# ---------------------------------------------------------------
NODE_ENV=production
BUILDORG=BuildBot
PORT=3000

# ---------------------------------------------------------------
# PostgreSQL (primary relational database)
# ---------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=builderbot
DB_USER=builderbot
DB_PASSWORD=changeme

# ---------------------------------------------------------------
# MongoDB (secondary document database)
# ---------------------------------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=builderbot
# Optional credentials (left blank by default for local dev)
MONGO_USER=
MONGO_PASSWORD=

# ---------------------------------------------------------------
# Redis (cache + session management)
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------
# Provider / bot specific (extend as needed)
# PORT=3000 already covered by Global
# DEBUG_PORT=9229 only used in docker-compose.dev.yml override

# ---------------------------------------------------------------
# CRM / n8n webhook + Google APIs
# ---------------------------------------------------------------
# CRM webhook shared secret (constant-time compare); never committed
CRM_WEBHOOK_SECRET=<random-secret>

# Google service-account JSON mount (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=/home/node/.n8n/gsa.json

# Google Calendar (service-account editor access required)
GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com

# Google Sheets (service-account editor access required)
GOOGLE_SHEETS_ID=<spreadsheet-id>

# n8n runtime / webhook endpoint
N8N_HOST=n8n.internal
WEBHOOK_URL=http://n8n:5678/webhook
